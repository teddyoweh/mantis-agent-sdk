{
  "capabilityTiers": {
    "version": 1,
    "updated": "2026-08-03",
    "note": "Coarse, provider-neutral capability tiers used to check that an advisor is actually an escalation. Explicit `models` entries win over `patterns`; the most specific pattern wins; anything unmatched falls to `default` and is FLAGGED as unknown. Sizes carry more signal than family names for open weights, so family patterns that would collide with a size tag (deepseek-r1:8b) are deliberately absent — those families are listed as exact ids instead, which only match the hosted full-size model.",

    "tiers": {
      "frontier": {"rank": 5, "description": "Strongest available reasoning"},
      "advanced": {"rank": 4, "description": "Near-frontier; handles hard multi-step work"},
      "standard": {"rank": 3, "description": "Competent general model"},
      "fast":     {"rank": 2, "description": "Cheap and quick; shallow on hard reasoning"},
      "small":    {"rank": 1, "description": "Runs anywhere; not a second opinion worth having"}
    },

    "default": "standard",

    "models": {
      "claude-opus-5": "frontier",
      "claude-opus-4-8": "frontier",
      "claude-sonnet-5": "advanced",
      "claude-haiku-4-5-20251001": "fast",

      "gpt-5.6": "frontier",
      "gpt-5.4": "advanced",

      "gemini-2.5-pro": "advanced",
      "gemini-2.5-flash": "fast",
      "gemini-2.0-flash": "fast",

      "deepseek-chat": "advanced",
      "deepseek-reasoner": "advanced",
      "deepseek-v3": "advanced",
      "deepseek-r1": "advanced",

      "kimi-latest": "advanced",
      "kimi-k2": "advanced",
      "kimi-k2-0905-preview": "advanced",
      "kimi-k2-instruct-0905": "advanced",
      "moonshot-v1-128k": "standard",
      "moonshot-v1-32k": "standard",

      "glm-4.7": "advanced",
      "glm-4.6": "advanced",
      "glm-4-plus": "advanced",
      "zai-glm-4.7": "advanced",
      "glm-4-flash": "fast",

      "qwen-max": "advanced",
      "qwen3-coder-plus": "advanced",
      "qwen3-235b-a22b": "advanced",
      "qwen-plus": "standard",

      "phi4": "fast",
      "mistral": "small",
      "llama3.2": "small"
    },

    "patterns": [
      {"match": "*-opus-*", "tier": "frontier", "note": "any vendor's spelling of an Opus id"},
      {"match": "*-sonnet-*", "tier": "advanced"},
      {"match": "*-haiku-*", "tier": "fast"},

      {"match": "gpt-5.6*", "tier": "frontier"},
      {"match": "gpt-5*-pro*", "tier": "frontier"},
      {"match": "gpt-5*-mini*", "tier": "fast"},
      {"match": "gpt-5*-nano*", "tier": "small"},
      {"match": "gpt-5*", "tier": "advanced", "note": "unrecognized GPT-5 variant"},
      {"match": "gpt-4o-mini*", "tier": "fast"},
      {"match": "gpt-4*", "tier": "standard"},
      {"match": "o3-mini*", "tier": "fast"},
      {"match": "o4-mini*", "tier": "fast"},
      {"match": "o3*", "tier": "advanced"},
      {"match": "o4*", "tier": "advanced"},

      {"match": "*gemini*pro*", "tier": "advanced"},
      {"match": "*gemini*flash*", "tier": "fast"},
      {"match": "*gemini*", "tier": "standard"},

      {"match": "*0.5b*", "tier": "small", "note": "parameter counts: the only signal a local tag reliably carries. Single-digit sizes are anchored to a ':' or '-' so '*7b*' cannot swallow '27b'; two- and three-digit sizes rely on the most-specific-wins rule instead ('*120b*' beats '*20b*')"},
      {"match": "*0.6b*", "tier": "small"},
      {"match": "*:1b*", "tier": "small"},
      {"match": "*-1b*", "tier": "small"},
      {"match": "*1.5b*", "tier": "small"},
